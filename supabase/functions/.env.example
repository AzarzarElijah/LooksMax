# Secrets for the analyze-scan Edge Function (and future functions in this project).
# Copy to .env and fill in for local `supabase functions serve --env-file supabase/functions/.env`.
# In deployed environments these are set via `supabase secrets set` instead of this file.
#
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected automatically by the
# Supabase platform for deployed functions — only needed here for local `functions serve`.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI/analysis provider (§15/§17). Defaults to "mock" — a free, no-API-key placeholder analysis
# (see _shared/providers/mock.ts) used until real API keys are purchased near the end of the
# build. Switch to "claude" or "gpt4v" (whichever eval/ picks) once real keys are ready.
ANALYSIS_PROVIDER=mock
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
